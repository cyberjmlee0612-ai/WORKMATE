# Supabase 프로젝트 URL (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres 연결 문자열 (Connect > Session pooler 권장: 직접 연결은 IPv6 전용일 수 있음)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 선택: 레거시 HS256 JWT secret을 쓰는 프로젝트만 설정. 비어 있으면 JWKS(비대칭 키)로 검증
SUPABASE_JWT_SECRET=

# 쉼표로 구분한 허용 출처
CORS_ORIGINS=http://localhost:3000
