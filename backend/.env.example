# Supabase 프로젝트 URL (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres 연결 문자열 (Connect > Session pooler 권장: 직접 연결은 IPv6 전용일 수 있음)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 선택: 레거시 HS256 JWT secret을 쓰는 프로젝트만 설정. 비어 있으면 JWKS(비대칭 키)로 검증
SUPABASE_JWT_SECRET=

# 쉼표로 구분한 허용 출처
CORS_ORIGINS=http://localhost:3000

# AI 업무 도우미 (선택). 비어 있으면 AI 기능만 꺼진다.
# Google AI Studio(https://aistudio.google.com)에서 발급. 무료 등급은 요청 수 제한이 있고 입력 내용이 서비스 개선에 쓰일 수 있다.
GEMINI_API_KEY=
# 기본값 gemini-3.5-flash-lite. 더 좋은 품질이 필요하면 gemini-3.8-flash (느림, 약 1분)
# GEMINI_MODEL=gemini-3.5-flash-lite
# 사용자당 하루 AI 요청 수
# AI_DAILY_LIMIT=30
